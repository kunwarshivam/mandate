// The Cloudflare Worker that serves web/ through OpenNext (DEC-823, DEC-731 item 3). The deploy job of
// .github/workflows/web-deploy.yml uploads it from main, with the account and token of the GitHub
// production environment (DEC-1005); this file names no account, route, build command, variable or
// credential. scripts/workers.mjs checks it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owlhead-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  // Only the custom domain serves the app: no workers.dev address and no preview URLs (DEC-823 item 2).
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The three public variables that point the app at staging's workspace (DEC-975, FOUNDER-STEPS
  // section P), committed here since DEC-2414 so a deploy sets them; none is a secret. Any other
  // variable the founder sets in the dashboard stays, through keep_vars (DEC-823 item 5).
  "vars": {
    "OWLHEAD_DATA_SOURCE": "api",
    "OWLHEAD_API_ORIGIN": "https://api-staging.owlhead.ai",
    "OWLHEAD_WORKSPACE_ID": "01KDEM0000000000000000000W"
  },
  "keep_vars": true,
  // OpenNext calls the Worker itself through this binding for revalidation and caching.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "owlhead-web" }]
}
