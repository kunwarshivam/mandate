# Sign-in with Supabase Auth (DEC-211). Copy to .env.local, which git ignores, and fill in.
# Both values are in the Supabase dashboard: Project Settings > API Keys (the publishable key) and
# the project's URL from the Connect dialog. The publishable key is meant to be public; it still
# lives only in .env.local. With either left empty the app runs on fixtures with no sign-in, as in CI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email magic links, hidden until the project has its own mail service. Set to 1 to show the form;
# Supabase's built-in mailer only sends to the project's team members and is rate-limited.
NEXT_PUBLIC_OWLHEAD_EMAIL_SIGNIN=
