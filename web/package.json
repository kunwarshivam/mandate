{
  "name": "mandate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "postbuild": "node scripts/no-apca.mjs && node scripts/no-scenarios.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4317",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pending": "node scripts/pending.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "brand": "node scripts/brand-assets.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@number-flow/react": "0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "cn": "^0.4.0",
    "lightweight-charts": "5.2.1",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "pixelarticons": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "webamp": "^2.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "apca-w3": "^0.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "4.139.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
