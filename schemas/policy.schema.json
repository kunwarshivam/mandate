{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/policy/1",
  "title": "Policy",
  "description": "Platform, organization, or workspace policy (mandate spec \u00a74.3, spec v0.6). Every key is optional; an absent key imposes no limit at that level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_schema_version",
    "level",
    "values"
  ],
  "properties": {
    "policy_schema_version": {
      "const": 1
    },
    "level": {
      "enum": [
        "platform",
        "organization",
        "workspace"
      ]
    },
    "profile": {
      "oneOf": [
        {
          "enum": [
            "internal_research",
            "retail"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission_auto_allowed": {
          "type": "boolean"
        },
        "allocation_usd": {
          "$ref": "#/$defs/positive_decimal"
        },
        "approval_timeout_s": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "asset_classes": {
          "$ref": "#/$defs/set",
          "items": {
            "enum": [
              "crypto",
              "us_equity"
            ]
          }
        },
        "auto_allowed": {
          "type": "boolean"
        },
        "breach_confirm_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "cadence_interval_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "channels": {
          "$ref": "#/$defs/set",
          "items": {
            "enum": [
              "email",
              "phone",
              "slack",
              "sms",
              "telegram",
              "web_push"
            ]
          }
        },
        "daily_breach_min_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "entry_threshold": {
          "$ref": "#/$defs/unit_positive"
        },
        "environments": {
          "$ref": "#/$defs/set",
          "items": {
            "enum": [
              "live",
              "paper"
            ]
          }
        },
        "exit_threshold": {
          "$ref": "#/$defs/unit_positive"
        },
        "exits_only_at_max": {
          "$ref": "#/$defs/open_fraction"
        },
        "goal_types": {
          "$ref": "#/$defs/set",
          "items": {
            "enum": [
              "accumulate",
              "continuous",
              "profit_stop"
            ]
          }
        },
        "hysteresis": {
          "$ref": "#/$defs/open_fraction"
        },
        "independent_approval_required": {
          "type": "boolean"
        },
        "leveraged_etps_allowed": {
          "type": "boolean"
        },
        "max_daily_loss": {
          "$ref": "#/$defs/open_fraction"
        },
        "max_drawdown": {
          "$ref": "#/$defs/open_fraction"
        },
        "max_gross_exposure_usd": {
          "$ref": "#/$defs/positive_decimal"
        },
        "max_instruments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_loss_from_allocation": {
          "$ref": "#/$defs/open_fraction"
        },
        "max_order_usd": {
          "$ref": "#/$defs/positive_decimal"
        },
        "max_orders_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_output_age_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "max_position_fraction": {
          "$ref": "#/$defs/unit_positive"
        },
        "max_position_usd": {
          "$ref": "#/$defs/positive_decimal"
        },
        "max_revisions_per_lineage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "protection_required": {
          "type": "boolean"
        },
        "rebalance_band": {
          "type": "string",
          "pattern": "^(0|0\\.[0-9]{0,27}[1-9]|1)$"
        },
        "reentry_cooldown_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "research_agent_allowed": {
          "type": "boolean"
        },
        "research_cost_cap_usd_per_day": {
          "$ref": "#/$defs/positive_decimal"
        },
        "research_interval_s": {
          "type": "integer",
          "minimum": 300,
          "maximum": 604800
        },
        "research_weight": {
          "$ref": "#/$defs/unit_positive"
        },
        "scale_lift_after_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "signal_model_types": {
          "$ref": "#/$defs/set",
          "items": {
            "enum": [
              "fast",
              "llm",
              "quant"
            ]
          }
        },
        "stagger_window_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "stop_distance_max": {
          "$ref": "#/$defs/open_fraction"
        },
        "two_approver_above_usd": {
          "$ref": "#/$defs/positive_decimal"
        }
      }
    }
  },
  "$defs": {
    "positive_decimal": {
      "type": "string",
      "pattern": "^(0\\.[0-9]{0,27}[1-9]|[1-9][0-9]{0,27}(\\.[0-9]{0,27}[1-9])?)$"
    },
    "open_fraction": {
      "type": "string",
      "pattern": "^0\\.[0-9]{0,27}[1-9]$"
    },
    "unit_positive": {
      "type": "string",
      "pattern": "^(0\\.[0-9]{0,27}[1-9]|1)$"
    },
    "set": {
      "type": "array",
      "uniqueItems": true
    }
  }
}
