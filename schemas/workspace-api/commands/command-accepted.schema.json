{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/command-accepted.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "command_id",
    "phase"
  ],
  "properties": {
    "command_id": {
      "$ref": "../common.schema.json#/$defs/EventId"
    },
    "phase": {
      "const": "recorded"
    },
    "step_up_status": {
      "$ref": "../envelope.schema.json#/$defs/StepUpStatus"
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/AsOf"
    }
  },
  "description": "The 202 of an owner command, a kill switch, or a revoke (\u00a75.4). step_up_status is the kill switch's alone, advisory.",
  "unevaluatedProperties": false
}
