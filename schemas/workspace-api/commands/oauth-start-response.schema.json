{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/oauth-start-response.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "authorization_url",
    "expires_at"
  ],
  "properties": {
    "authorization_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "expires_at": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    }
  },
  "description": "POST /connections/oauth/start (\u00a74.5, DEC-821): no secret-shaped member (API-11). Reads no stream, so as_of may be empty.",
  "propertyNames": {
    "not": {
      "pattern": "(?i)(token|secret|password|passphrase|credential|api_key|private_key|account_number|fingerprint|vault)"
    }
  },
  "unevaluatedProperties": false
}
