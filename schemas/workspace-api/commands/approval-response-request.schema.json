{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/approval-response-request.schema.json",
  "type": "object",
  "required": [
    "verdict",
    "content_hash",
    "record",
    "step_up",
    "delegation"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "enum": [
        "approved",
        "skipped"
      ]
    },
    "content_hash": {
      "$ref": "../common.schema.json#/$defs/ContentRef"
    },
    "record": {
      "$ref": "../envelope.schema.json#/$defs/Record"
    },
    "step_up": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/StepUpEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "delegation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "preview_id",
            "mandate_version"
          ],
          "additionalProperties": false,
          "properties": {
            "preview_id": {
              "$ref": "../common.schema.json#/$defs/Id"
            },
            "mandate_version": {
              "$ref": "../common.schema.json#/$defs/ContentRef"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "POST /approvals/{approval_id}/responses (\u00a75.2). Users only. A missing step-up on approved is 401 step_up_required; skipped is never refused for step-up (API-7)."
}
