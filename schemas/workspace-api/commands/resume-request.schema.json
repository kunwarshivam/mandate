{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/resume-request.schema.json",
  "type": "object",
  "required": [
    "record",
    "step_up"
  ],
  "additionalProperties": false,
  "properties": {
    "record": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/Record"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_up": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/StepUpEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_up_assertion": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/StepUpAssertion"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "if": {
    "properties": {
      "step_up_assertion": {
        "type": "object"
      }
    },
    "required": [
      "step_up_assertion"
    ]
  },
  "then": {
    "properties": {
      "step_up": {
        "type": "object",
        "properties": {
          "method": {
            "const": "passkey"
          }
        }
      }
    }
  },
  "description": "POST /agents/{agent_id}/resume (\u00a75.4): missing step-up is forwarded and refused by the runtime (OwnerCommandRefused). step_up_assertion is DEC-2108 item 7's object beside passkey step-up, optional so a body written before it still decodes; set only beside a step_up whose method is passkey (DEC-2140)."
}
