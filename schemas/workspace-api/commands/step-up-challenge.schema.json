{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/step-up-challenge.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "challenge_id",
    "webauthn_challenge",
    "action",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "challenge_id": {
      "$ref": "../common.schema.json#/$defs/EventId"
    },
    "webauthn_challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "action": {
      "$ref": "../envelope.schema.json#/$defs/StepUpAction"
    },
    "issued_at": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    },
    "expires_at": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    }
  },
  "description": "POST /step-up/challenges' 201 (\u00a73.6, DEC-2103 item 3): the challenge record's id, action, and instants, and webauthn_challenge, the unpadded base64url of the SHA-256 of the canonical record (identity spec \u00a77.2 step 2). Reads no stream, so as_of is empty.",
  "propertyNames": {
    "not": {
      "pattern": "([tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[aA][cC][cC][oO][uU][nN][tT]_[nN][uU][mM][bB][eE][rR]|[fF][iI][nN][gG][eE][rR][pP][rR][iI][nN][tT]|[vV][aA][uU][lL][tT])"
    }
  },
  "unevaluatedProperties": false
}
