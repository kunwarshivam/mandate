{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/commands/stop-request.schema.json",
  "type": "object",
  "required": [
    "release",
    "warning_shown",
    "record",
    "step_up"
  ],
  "additionalProperties": false,
  "properties": {
    "release": {
      "type": "boolean"
    },
    "warning_shown": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/ContentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/Record"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_up": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/StepUpEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_up_assertion": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/StepUpAssertion"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "POST /agents/{agent_id}/stop (\u00a74.2): release and warning_shown as DEC-290 item 2 journals them; the warning digest exactly when release is true. step_up_assertion only beside a step_up whose method is passkey (DEC-2140).",
  "if": {
    "properties": {
      "release": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "warning_shown": {
        "$ref": "../common.schema.json#/$defs/ContentRef"
      }
    }
  },
  "else": {
    "properties": {
      "warning_shown": {
        "type": "null"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "step_up_assertion": {
            "type": "object"
          }
        },
        "required": [
          "step_up_assertion"
        ]
      },
      "then": {
        "properties": {
          "step_up": {
            "type": "object",
            "properties": {
              "method": {
                "const": "passkey"
              }
            }
          }
        }
      }
    }
  ]
}
