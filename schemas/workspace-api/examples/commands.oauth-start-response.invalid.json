[
  {
    "label": "a code verifier member",
    "set": {
      "/code_verifier_secret": "x"
    }
  },
  {
    "label": "an http URL",
    "set": {
      "/authorization_url": "http://broker.example/oauth/authorize"
    }
  },
  {
    "label": "an access token member",
    "set": {
      "/access_token": "x"
    }
  },
  {
    "label": "a URL with a trailing newline",
    "set": {
      "/authorization_url": "https://broker.example/oauth/authorize\n"
    }
  },
  {
    "label": "a capitalised secret member",
    "set": {
      "/Client_Secret": "x"
    }
  },
  {
    "label": "a vault reference",
    "set": {
      "/vault_ref": "x"
    }
  },
  {
    "label": "auto: no /authorization_url",
    "remove": [
      "/authorization_url"
    ]
  },
  {
    "label": "auto: no /expires_at",
    "remove": [
      "/expires_at"
    ]
  },
  {
    "label": "auto: an extra member in the body",
    "set": {
      "/mutant_member": 1
    }
  }
]
