{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/read-models/positions.schema.json",
  "description": "GET /agents/{id}/positions (§4.7 D3, DEC-2111). positions is the net filled quantity of the agent's own orders per instrument, from the FillApplied and LateFillApplied records of orders whose OrderRequestRecorded names the agent; its cost_basis is the agent sub-ledger's §8.1 position (DEC-2138). account_positions is the account's, not the agent's: the latest BrokerPositionObserved per instrument, as GET /agents/{id} serves it (DEC-1020), null when the account stream is not found. as_of names the control stream and the account stream read.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "agent_id",
    "account_ref",
    "positions",
    "account_positions"
  ],
  "properties": {
    "agent_id": {
      "$ref": "../common.schema.json#/$defs/Id"
    },
    "account_ref": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Position"
      }
    },
    "account_positions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "agent.schema.json#/$defs/Position"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/AsOf"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Position": {
      "description": "One instrument the agent's own fills left a non-zero net quantity in, in instrument order (DEC-2111 item 4). cost_basis, risk_mark, market_value, unrealized_pnl and protection are DEC-2138's: null where the journal does not say, never zero or guessed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "filled_qty",
        "cost_basis",
        "risk_mark",
        "market_value",
        "unrealized_pnl",
        "protection"
      ],
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "filled_qty": {
          "$ref": "../common.schema.json#/$defs/Decimal"
        },
        "cost_basis": {
          "description": "The agent sub-ledger's signed quantity and signed cost basis (trading spec §8.1, DEC-2138 item 1), folded from its own fills; null after a release, a corporate action, or a fee charged in the asset.",
          "anyOf": [
            {
              "$ref": "#/$defs/CostBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_mark": {
          "description": "The instrument's latest version-2 MarkUpdated from a counted session (DEC-2138 item 2); null when there is none.",
          "anyOf": [
            {
              "$ref": "#/$defs/RiskMark"
            },
            {
              "type": "null"
            }
          ]
        },
        "market_value": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "cost_basis.qty × risk_mark.bid (trading spec §8.2), null unless both are served and the mark is sane (DEC-2138 item 3)."
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "market_value − cost_basis.basis (trading spec §8.2), null when market_value is."
        },
        "protection": {
          "$ref": "#/$defs/Protection"
        }
      }
    },
    "CostBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qty",
        "basis"
      ],
      "properties": {
        "qty": {
          "$ref": "../common.schema.json#/$defs/Decimal"
        },
        "basis": {
          "$ref": "../common.schema.json#/$defs/Decimal"
        }
      }
    },
    "RiskMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid",
        "sane",
        "session",
        "marked_at"
      ],
      "properties": {
        "bid": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "sane": {
          "type": "boolean"
        },
        "session": {
          "enum": [
            "regular",
            "crypto"
          ]
        },
        "marked_at": {
          "$ref": "../common.schema.json#/$defs/Timestamp"
        }
      },
      "description": "A risk mark as journaled: bid, verdict, session and risk_clock. A sane mark carries a bid (journal spec rule 244).",
      "if": {
        "properties": {
          "sane": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "bid": {
            "$ref": "../common.schema.json#/$defs/Decimal"
          }
        }
      }
    },
    "Protection": {
      "description": "The account's protective orders in the instrument and its open unprotected interval, folded from ProtectionChanged as the executor folds it (trading spec §5.4, DEC-2138 item 4). With no record: no order, covered_qty 0, the rest null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orders",
        "covered_qty",
        "stop",
        "take_profit",
        "unprotected_since"
      ],
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        },
        "covered_qty": {
          "$ref": "../common.schema.json#/$defs/Decimal"
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "take_profit": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "unprotected_since": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
