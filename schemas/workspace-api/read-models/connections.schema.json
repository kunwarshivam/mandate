{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/read-models/connections.schema.json",
  "description": "GET /connections (§4.5, DEC-2620): every connection the control stream names, in the order its first record names it. as_of names the control stream. References only: no secret-shaped member (API-11).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "connections"
  ],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "$ref": "connection.schema.json#/$defs/Connection"
      }
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/AsOf"
    }
  },
  "unevaluatedProperties": false
}
