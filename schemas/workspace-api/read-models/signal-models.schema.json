{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/read-models/signal-models.schema.json",
  "description": "GET /signal-models (§4.1, §3.11 item 11, DEC-2136): the signal models a version may name in this workspace, one per ConfigSnapshotRegistered of kind model_version on the control stream (V-007), the latest registration per model id and version, with the content object stored under its content_hash. Sorted by model_id, then model_version. Platform-authored descriptions only: no performance, scorecard or recommendation (DEC-126, DEC-99). as_of names the control stream. A registration whose content the store cannot give makes the whole read journal_unavailable.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "models"
  ],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Model"
      }
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/AsOf"
    }
  },
  "$defs": {
    "Model": {
      "type": "object",
      "required": [
        "model_id",
        "model_version",
        "content_hash",
        "params",
        "admits_instruments",
        "content",
        "registered_at"
      ],
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "description": "The mandate schema's signal_model id.",
          "type": "string",
          "pattern": "^(fast|llm|quant)\\.[a-z0-9_]{1,48}$"
        },
        "model_version": {
          "description": "The mandate schema's signal_model version.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
        },
        "content_hash": {
          "description": "The value a mandate's signal_models[].content_hash names (mandate spec §8.1).",
          "$ref": "../common.schema.json#/$defs/ContentRef"
        },
        "params": {
          "description": "The registration's declared parameter names (V-007), ascending.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "admits_instruments": {
          "type": "boolean"
        },
        "content": {
          "description": "The model's content object exactly as stored under content_hash (DEC-504, DEC-518 item 3): for a quant model, its methodology and params_schema (each parameter's name, type and bounds, and constraints). The client renders it as platform-authored text, never as advice.",
          "type": "object",
          "required": [
            "kind",
            "model_id",
            "model_version"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "model_version": {
              "type": "string"
            }
          }
        },
        "registered_at": {
          "description": "The ConfigSnapshotRegistered row's recorded_at.",
          "$ref": "../common.schema.json#/$defs/Timestamp"
        }
      }
    }
  },
  "propertyNames": {
    "not": {
      "pattern": "([tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[aA][cC][cC][oO][uU][nN][tT]_[nN][uU][mM][bB][eE][rR]|[fF][iI][nN][gG][eE][rR][pP][rR][iI][nN][tT]|[vV][aA][uU][lL][tT])"
    }
  },
  "unevaluatedProperties": false
}
