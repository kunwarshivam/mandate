{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/read-models/approvals.schema.json",
  "description": "GET /approvals?state=pending|resolved (\u00a74.3, DEC-979): pending approvals by deadline, then resolved ones, most recent first. as_of names the control stream and each agent stream read.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/Envelope"
    }
  ],
  "required": [
    "approvals"
  ],
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "approval.schema.json#/$defs/Approval"
      }
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/AsOf"
    }
  },
  "unevaluatedProperties": false
}
