{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandate.dev/schemas/workspace-api/v1/read-models/pnl.schema.json",
  "title": "GET /agents/{id}/pnl",
  "description": "Realized and unrealized P&L from the ledger fold, paper labeled simulated, with disclosures named by document and version, never drafted text (rule 9). No scorecard: FR-8.4 serves those only at GET /agents/{id}/scorecards. docs/specs/workspace-api.md §4.7, §4.10 (DEC-741).",
  "allOf": [{ "$ref": "../envelope.schema.json#/$defs/Envelope" }, { "$ref": "agent.schema.json#/$defs/PaperIsSimulated" }],
  "type": "object",
  "required": ["agent_id", "environment", "simulated", "pnl_total", "pnl_today", "realized_pnl", "unrealized_pnl", "marks_freshness", "disclosures"],
  "properties": {
    "as_of": { "$ref": "../common.schema.json#/$defs/AsOf", "description": "API-14: a read model names every stream it read, so its watermarks are never empty." },
    "agent_id": { "$ref": "../common.schema.json#/$defs/Id" },
    "environment": { "$ref": "agent.schema.json#/$defs/Environment" },
    "simulated": { "type": "boolean" },
    "pnl_total": { "$ref": "../common.schema.json#/$defs/Decimal" },
    "pnl_today": { "$ref": "../common.schema.json#/$defs/Decimal" },
    "realized_pnl": { "$ref": "../common.schema.json#/$defs/Decimal" },
    "unrealized_pnl": { "$ref": "../common.schema.json#/$defs/Decimal" },
    "marks_freshness": { "$ref": "#/$defs/MarksFreshness" },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "version"],
        "properties": {
          "document": { "$ref": "../common.schema.json#/$defs/Id" },
          "version": { "$ref": "../common.schema.json#/$defs/ContentRef" }
        }
      }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "MarksFreshness": {
      "description": "The oldest mark the unrealized figure uses, or null with no position.",
      "oneOf": [{ "$ref": "../common.schema.json#/$defs/Freshness" }, { "type": "null" }]
    }
  }
}
