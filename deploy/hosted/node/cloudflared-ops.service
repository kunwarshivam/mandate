# The ops tunnel `cell1-ops` (DEC-2000 item 3): the founder's SSH and kubectl reach cell1-a only
# through it, behind Cloudflare Access, so the droplets open no inbound port. The token is a
# systemd credential, /etc/cell1/credentials/ops-tunnel-token, root:root 0600, handed to this
# service alone in $CREDENTIALS_DIRECTORY, never in this unit, the environment or a command line.
# Its routes (ssh://localhost:22, tcp://localhost:6443) are the tunnel's remote configuration,
# which deploy/hosted/cell1.py sets.
[Unit]
Description=Cloudflare Tunnel cell1-ops
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cell1/credentials/ops-tunnel-token

[Service]
Type=notify
LoadCredential=tunnel-token:/etc/cell1/credentials/ops-tunnel-token
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=5s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
