# /etc/owlhead/api.env: the workspace API's settings (DEC-822 item 4, DEC-692). It holds NO secret.
# bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it; systemd
# reads it before dropping to owlhead_api. set-secrets.sh fills the empty values on the host.
#
# The API's two secrets are systemd credentials, never environment variables: the vault's pending
# key and the session signing key, root:root 0600 files under /etc/owlhead/credentials/, which the
# unit loads with LoadCredential= and the API reads from $CREDENTIALS_DIRECTORY. The Alpaca client
# secret is in the vault, imported once, and is the executor's alone (infrastructure §5.1).
#
# The names are PROVISIONAL: the API server (A2) takes these names from this file. A change here
# is a change to the server's configuration, made in both places together.

# How the API reaches PostgreSQL: over the Unix socket, as the owlhead_api role, by peer
# authentication, so there is no password. "localhost" is only there because the URL needs a host
# part; the host parameter sends it to the socket.
MANDATE_API_DATABASE_URL=postgresql://owlhead_api@localhost/owlhead?host=/var/run/postgresql

# The minimal vault (V1, DEC-692). Its keys are credentials, not here.
MANDATE_VAULT_DIR=/var/lib/owlhead/vault

# The Alpaca OAuth app's client id, from Alpaca's dashboard (DEC-821; paper only). Public; the API
# puts it in the authorization redirect.
ALPACA_OAUTH_CLIENT_ID=
