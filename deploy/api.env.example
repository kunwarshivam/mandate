# /etc/owlhead/api.env: the workspace API's settings and secrets (DEC-822 item 4).
# bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it.
# set-secrets.sh fills the empty values on the host, last, right before the first start. Never
# paste a value into chat, an issue, a commit, or a log. This committed copy holds names only,
# except the database URL below, which holds no secret.
#
# The names are PROVISIONAL: the API server (A2) takes these names from this file. A change here
# is a change to the server's configuration, made in both places together.

# How the API reaches PostgreSQL: over the Unix socket, as the owlhead_api role, by peer
# authentication, so there is no password. "localhost" is only there because the URL needs a host
# part; the host parameter sends it to the socket.
MANDATE_API_DATABASE_URL=postgresql://owlhead_api@localhost/owlhead?host=/var/run/postgresql

# Signs the API's session tokens. Random, 32 bytes, base64. Changing it signs everyone out.
MANDATE_API_SESSION_SIGNING_KEY=

# Encrypts the minimal vault in /var/lib/owlhead/vault that holds broker OAuth tokens until the
# infrastructure vault exists (DEC-822 item 4). Random, 32 bytes, base64. Losing it loses every
# stored connection; keep a copy in a password manager.
MANDATE_VAULT_KEY=

# The Alpaca OAuth app's client id and secret, from Alpaca's dashboard (DEC-821; paper only).
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
