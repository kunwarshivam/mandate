# /etc/owlhead/api.env: the workspace API's settings and secrets (DEC-822 item 4).
# bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it.
# Fill it on the host, last, right before the first start. Never paste a value into chat, an
# issue, a commit, or a log. This committed copy holds NAMES and comments only.
#
# Make each random key on the host itself, so it never leaves it:
#   openssl rand -base64 32

# How the API reaches PostgreSQL: over the Unix socket, as the owlhead_api role, by peer
# authentication, so there is no password. Not secret; this is the value to use:
#   postgresql://owlhead_api@localhost/owlhead?host=/var/run/postgresql
# (the host parameter sends it to the socket; "localhost" is only there because the URL needs a
# host part)
MANDATE_API_DATABASE_URL=

# Signs the API's session tokens. Random, 32 bytes, base64. Changing it signs everyone out.
MANDATE_API_SESSION_SIGNING_KEY=

# Encrypts the local vault that holds broker OAuth tokens until the infrastructure vault exists
# (DEC-822 item 4). Random, 32 bytes, base64. Losing it loses every stored connection; keep a
# copy offline (a password manager), never on this host's disk elsewhere.
MANDATE_VAULT_KEY=

# The Alpaca OAuth app's client id and secret, from Alpaca's dashboard (DEC-821; paper only).
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
