# /etc/owlhead/api.env: the workspace API's settings and secrets (DEC-822 item 4, DEC-692).
# bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it; systemd
# reads it before dropping to owlhead_api. set-secrets.sh fills the empty values on the host, last.
# Never paste a value into chat, an issue, a commit, or a log. This committed copy holds names only,
# except the database URL and the vault directory, which hold no secret.
#
# The names are PROVISIONAL: the API server (A2) takes these names from this file. A change here
# is a change to the server's configuration, made in both places together. The Alpaca client
# secret is not here: it is the executor's alone (executor.env; infrastructure §5.1).

# How the API reaches PostgreSQL: over the Unix socket, as the owlhead_api role, by peer
# authentication, so there is no password. "localhost" is only there because the URL needs a host
# part; the host parameter sends it to the socket.
MANDATE_API_DATABASE_URL=postgresql://owlhead_api@localhost/owlhead?host=/var/run/postgresql

# Signs the API's session tokens. Random, 32 bytes, base64. Changing it signs everyone out.
MANDATE_API_SESSION_SIGNING_KEY=

# The minimal vault (V1, DEC-692) and its key: one random 32-byte key, base64, the same value in
# executor.env. It is never in a backup; keep a copy in a password manager. Losing it means every
# connection is re-authorized after a restore.
MANDATE_VAULT_DIR=/var/lib/owlhead/vault
MANDATE_VAULT_KEY=

# The Alpaca OAuth app's client id, from Alpaca's dashboard (DEC-821; paper only). Public; the API
# puts it in the authorization redirect.
ALPACA_OAUTH_CLIENT_ID=
