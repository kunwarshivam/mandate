# /etc/owlhead/executor.env: a connection executor's settings (DEC-822 item 4, DEC-692). It holds
# NO secret. bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it;
# systemd reads it before dropping to owlhead_exec. set-secrets.sh fills the empty values.
#
# The executor's two secrets are systemd credentials, never environment variables: the vault's
# pending key and its token key, which only the executor holds, root:root 0600 files under
# /etc/owlhead/credentials/, loaded with LoadCredential= and read from $CREDENTIALS_DIRECTORY. The
# Alpaca client secret is in the vault, imported once (`mandate vault import`, V1).
#
# The names are PROVISIONAL: the executor (the live lane) and V1 take them from this file.

# The executor's own database role, owlhead_exec, by peer authentication over the socket.
MANDATE_EXECUTOR_DATABASE_URL=postgresql://owlhead_exec@localhost/owlhead?host=/var/run/postgresql

# The minimal vault. Its keys are credentials, not here; losing the token key means every
# connection is re-authorized after a restore.
MANDATE_VAULT_DIR=/var/lib/owlhead/vault

# The Alpaca OAuth app's client id (DEC-821; paper only). Public. Its secret is in the vault.
ALPACA_OAUTH_CLIENT_ID=
