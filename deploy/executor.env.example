# /etc/owlhead/executor.env: a connection executor's settings and secrets (DEC-692).
# bootstrap.sh copies this file there as root:root, mode 0600, and never overwrites it; systemd
# reads it before dropping to owlhead_exec. set-secrets.sh fills the empty values on the host,
# last. This committed copy holds names only, except the database URL and the vault directory.
#
# The names are PROVISIONAL: the executor (the live lane) and V1 take them from this file.

# The executor's own database role, owlhead_exec, by peer authentication over the socket.
MANDATE_EXECUTOR_DATABASE_URL=postgresql://owlhead_exec@localhost/owlhead?host=/var/run/postgresql

# The minimal vault and its two keys: pending/'s, the same as api.env's, and tokens/', which only
# the executor holds. Random, 32 bytes, base64 each; never in a backup. Losing the token key means
# every connection is re-authorized after a restore.
MANDATE_VAULT_DIR=/var/lib/owlhead/vault
MANDATE_VAULT_PENDING_KEY=
MANDATE_VAULT_TOKEN_KEY=

# The Alpaca OAuth app's client id and secret (DEC-821; paper only). The secret is the executor's
# alone: the API never holds it (infrastructure §5.1).
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
