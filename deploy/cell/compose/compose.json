  "services": {
    "api": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "--bind",
        "127.0.0.1:8080",
        "--probe-bind",
        "127.0.0.1:8081"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "0.25",
            "memory": "128M"
          },
          "reservations": {
            "cpus": "0.1",
            "memory": "64M"
          }
        }
      },
      "environment": {
        "CREDENTIALS_DIRECTORY": "/run/secrets",
        "HOME": "/tmp",
        "MANDATE_API_APP_ORIGIN": "${MANDATE_API_APP_ORIGIN:?set MANDATE_API_APP_ORIGIN}",
        "MANDATE_API_AUDIENCE": "${MANDATE_API_AUDIENCE:?set MANDATE_API_AUDIENCE}",
        "MANDATE_API_DATABASE_URL": "postgres://mandate_api@postgres:5432/mandate?sslmode=disable",
        "MANDATE_API_ISSUER": "${MANDATE_API_ISSUER:?set MANDATE_API_ISSUER}",
        "MANDATE_API_JWKS_URL": "${MANDATE_API_JWKS_URL:?set MANDATE_API_JWKS_URL}",
        "MANDATE_API_ORG": "${MANDATE_API_ORG:?set MANDATE_API_ORG}",
