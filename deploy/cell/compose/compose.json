        "PGPASSFILE": "/run/secrets/journal-role-mandate-api"
      },
      "image": "${MANDATE_IMAGE_API:?set the api image, pinned by digest}",
      "labels": {
        "mandate.dev/process": "api",
        "mandate.dev/workspace": "${MANDATE_WORKSPACE:?set the workspace}"
      },
      "networks": [
        "journal",
        "egress"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        "journal-role-mandate-api",
        {
          "source": "api-session-signing-key",
          "target": "session-signing-key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/work"
      ],
      "user": "999:999"
    },
    "control": {
      "cap_drop": [
        "ALL"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "0.2",
            "memory": "128M"
          },
          "reservations": {
            "cpus": "0.1",
            "memory": "64M"
          }
        }
      },
      "environment": {
        "HOME": "/tmp",
        "MANDATE_JOURNAL_DSN": "postgres://mandate_control@postgres:5432/mandate?sslmode=disable",
        "PGPASSFILE": "/run/secrets/journal-role-mandate-control"
      },
      "image": "${MANDATE_IMAGE_MANDATE:?set the mandate image, pinned by digest}",
      "labels": {
        "mandate.dev/process": "control",
        "mandate.dev/workspace": "${MANDATE_WORKSPACE:?set the workspace}"
      },
      "networks": [
        "journal",
        "egress"
      ],
      "profiles": [
        "run"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        "journal-role-mandate-control"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "999:999"
    },
    "journal-verify": {
      "cap_drop": [
        "ALL"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "0.2",
            "memory": "128M"
          },
          "reservations": {
            "cpus": "0.1",
            "memory": "64M"
          }
        }
      },
      "environment": {
        "HOME": "/tmp",
        "MANDATE_JOURNAL_DSN": "postgres://mandate_verify@postgres:5432/mandate?sslmode=disable",
        "PGPASSFILE": "/run/secrets/journal-role-mandate-verify"
      },
      "image": "${MANDATE_IMAGE_MANDATE:?set the mandate image, pinned by digest}",
      "labels": {
