        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres-superuser",
        "POSTGRES_USER": "postgres"
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "mandate"
        ]
      },
      "image": "postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336",
      "networks": [
        "journal"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        "postgres-superuser",
        "journal-role-mandate-migrator",
        "journal-role-mandate-control",
        "journal-role-mandate-executor",
        "journal-role-mandate-verify",
        "journal-role-mandate-api",
        "journal-role-mandate-deploy-manager",
        "journal-role-mandate-role-provisioner",
        "journal-role-mandate-connect-finish",
        "journal-role-mandate-runtime",
        "journal-role-mandate-scheduler",
        "journal-role-mandate-gateway",
        "journal-role-mandate-exporter"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql"
      ],
      "volumes": [
        "journal-data:/var/lib/postgresql"
      ]
    },
    "runtime": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "run",
        "--workspace",
        "${MANDATE_WORKSPACE:?set the workspace}",
        "--agent",
        "${MANDATE_RUNTIME_AGENT:?set the runtime's agent}",
        "--connection",
        "${MANDATE_RUNTIME_CONNECTION:?set the runtime's connection}",
        "--owner",
        "${MANDATE_RUNTIME_OWNER:?set the runtime's owner}",
        "--probe",
        "/tmp/process.sock"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "0.25",
            "memory": "256M"
          },
          "reservations": {
            "cpus": "0.1",
            "memory": "128M"
          }
        }
      },
      "environment": {
        "HOME": "/tmp",
        "MANDATE_JOURNAL_DSN": "postgres://mandate_runtime@postgres:5432/mandate?sslmode=disable",
        "PGPASSFILE": "/run/secrets/journal-role-mandate-runtime"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 6,
        "test": [
          "CMD",
          "/mandate-daemon",
          "probe",
          "readyz",
          "--probe",
          "/tmp/process.sock"
        ]
      },
      "image": "${MANDATE_IMAGE_RUNTIME:?set the runtime image, pinned by digest}",
      "labels": {
        "mandate.dev/process": "runtime",
        "mandate.dev/workspace": "${MANDATE_WORKSPACE:?set the workspace}"
      },
      "networks": [
        "journal",
        "egress"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        "journal-role-mandate-runtime"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/work"
      ],
      "user": "999:999"
    }
  },
  "volumes": {
