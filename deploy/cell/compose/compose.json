      "user": "999:999",
      "volumes": [
        "../../../migrations:/migrations:ro",
        "../charts/workspace/files/migrate.sh:/opt/mandate/migrate.sh:ro"
      ]
    },
    "postgres": {
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETGID",
        "SETUID"
      ],
      "cap_drop": [
        "ALL"
      ],
      "configs": [
        {
          "source": "journal-initdb",
          "target": "/docker-entrypoint-initdb.d/10-journal.sh"
