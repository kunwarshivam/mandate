        "mandate.dev/workspace": "${MANDATE_WORKSPACE:?set the workspace}"
      },
      "networks": [
        "journal"
      ],
      "profiles": [
        "run"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        "journal-role-mandate-verify"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "999:999"
    },
    "migrate": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "bash",
        "/opt/mandate/migrate.sh"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "0.2",
            "memory": "128M"
          },
          "reservations": {
            "cpus": "0.1",
            "memory": "64M"
          }
        }
      },
      "environment": {
        "HOME": "/tmp",
        "MANDATE_JOURNAL_DSN": "postgres://mandate_migrator@postgres:5432/mandate?sslmode=disable",
        "PGPASSFILE": "/run/secrets/journal-role-mandate-migrator"
      },
      "image": "ghcr.io/cloudnative-pg/postgresql:18.6-202609281634-minimal-trixie@sha256:4467d4cf7e502fbc29800b75d755ede477a765b25a506a58a0842a57a4bf42c9",
      "labels": {
        "mandate.dev/process": "migrate",
        "mandate.dev/workspace": "${MANDATE_WORKSPACE:?set the workspace}"
      },
      "networks": [
        "journal"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        "journal-role-mandate-migrator"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
