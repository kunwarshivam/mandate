{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mandate-journal-db values",
  "description": "Settings only: every password is made in the cluster by the chart, never a value (DEC-822 item 4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instances",
    "failureDomain",
    "image",
    "storage",
    "resources",
    "operatorNamespace",
    "archive",
    "kubeApi",
    "dns"
  ],
  "properties": {
    "instances": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3
    },
    "failureDomain": {
      "enum": [
        "separate",
        "shared"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "storageClass"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "operatorNamespace": {
      "type": "string",
      "minLength": 1
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointURL",
        "destinationPath",
        "keyFrom",
        "retention",
        "baseBackupSchedule",
        "egress"
      ],
      "properties": {
        "endpointURL": {
          "type": "string",
          "pattern": "^(https://[a-z0-9.-]+(:[0-9]+)?|http://[a-z0-9-]+\\.[a-z0-9-]+\\.svc(\\.cluster\\.local)?(:[0-9]+)?)$"
        },
        "destinationPath": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9._-]+)*$"
        },
        "keyFrom": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "retention": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[dwm]$"
        },
        "baseBackupSchedule": {
          "type": "string",
          "minLength": 1
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidrs",
            "port",
            "namespace",
            "podSelector"
          ],
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(2[4-9]|3[0-2])$"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "namespace": {
              "type": "string"
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "kubeApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidrs",
        "ports"
      ],
      "properties": {
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "podSelector"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "podSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "minProperties": 1
        }
      }
    }
  }
}
