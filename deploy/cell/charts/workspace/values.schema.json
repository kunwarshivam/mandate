{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mandate-workspace values (E21-36)",
  "description": "Settings only: no key may hold a secret (DEC-822 item 4), and no key outside this schema is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "environment",
    "images",
    "journal",
    "rolePrefix",
    "egress",
    "run",
    "verify",
    "runtime",
    "localImages",
    "ingress",
    "deploymentTier",
    "api",
    "artifacts",
    "researchArtifacts",
    "founding",
    "executor",
    "alpacaOAuth",
    "oauthFixture",
    "news"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "environment": {
      "description": "paper or backtest only (DEC-967 item 15); the live Robinhood connection of E21-48 is not in this chart",
      "enum": [
        "paper",
        "backtest"
      ]
    },
    "deploymentTier": {
      "description": "MANDATE_DEPLOYMENT_TIER for every process (DEC-971 item 2): the start-up check refuses an unsigned build outside dev and ci, and any value it does not know is production",
      "enum": [
        "dev",
        "ci",
        "staging",
        "production"
      ]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "mandate",
        "api",
        "stub-issuer",
        "runtime",
        "executor",
        "token-exchange",
        "scheduler",
        "dispatcher",
        "model-gateway",
        "exporter",
        "data",
        "news-reader",
        "deploy-manager",
        "role-provisioner"
      ],
      "properties": {
        "postgres": {
          "type": "string",
          "pattern": "^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"
        },
        "mandate": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "api": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "stub-issuer": {
          "type": "string",
          "pattern": "^$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$",
          "description": "The local stub token issuer (DEC-2100), a sidecar in the API pod for a dev or ci cell's sign-in. Only a local build can be named, and only the local cell's values allow a local build (localImages), so a hosted values file cannot run it (DEC-1025)."
        },
        "runtime": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "executor": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "token-exchange": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "scheduler": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "dispatcher": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "model-gateway": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "exporter": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "data": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "news-reader": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$",
          "description": "The news reader (DEC-2084): a released image pinned by digest, never a local build, since no cell runs it"
        },
        "deploy-manager": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        },
        "role-provisioner": {
          "type": "string",
          "pattern": "^$|^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$|^mandate\\.local/[a-z0-9-]+:[0-9a-f]{7,40}$"
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "database",
        "ca",
        "podSelector"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "ca": {
          "type": "string",
          "minLength": 1
        },
        "podSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        }
      }
    },
    "rolePrefix": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "token-host",
        "time",
        "model-providers",
        "object-storage",
        "timestamping",
        "market-data",
        "artifact-store",
        "identity-provider",
        "dns",
        "kube-api",
        "kubeApiPort"
      ],
      "properties": {
        "broker": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "token-host": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$"
          }
        },
        "time": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "model-providers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "object-storage": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "timestamping": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "market-data": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "podSelector"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 1
            }
          }
        },
        "artifact-store": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "identity-provider": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "kube-api": {
          "description": "The API server's endpoint addresses, for the deployment manager alone (DEC-1172); empty allows nothing",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
          }
        },
        "kubeApiPort": {
          "description": "The port the API server's endpoints listen on (6443 on k3s)",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "args"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{0,20}$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "description": "The run process this run runs (DEC-2035); a name that is no run process fails the render",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "streams"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{0,20}$"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(acct|agent|ctl|clock|meter):[A-Za-z0-9:_.-]+$"
          }
        }
      }
    },
    "runtime": {
      "description": "The agent deployment the runtime process runs (DEC-1013); ids only, never a secret",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "connection",
        "owner"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "connection": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "owner": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "research": {
          "type": "string",
          "pattern": "^$|^/usr/local/share/mandate/research$"
        }
      }
    },
    "deployManager": {
      "description": "The second deployment manager's workspace, for the research agent alone: dev or ci, or staging beside the model gateway (DEC-2070, DEC-2080)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchWorkspace"
      ],
      "properties": {
        "researchWorkspace": {
          "type": "string",
          "pattern": "^$|^[0-9A-HJKMNP-TV-Z]{26}r$"
        }
      }
    },
    "modelGateway": {
      "description": "The model-gateway service's workspace and deployment, ids only, its two monthly budgets, and the live registry file a hosted cell starts it from (E21-62, DEC-2326, DEC-2081)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "deployment",
        "workspaceMonthlyUsd",
        "deploymentMonthlyUsd",
        "registry"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "pattern": "^$|^[0-9A-HJKMNP-TV-Z]{26}r?$"
        },
        "deployment": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "workspaceMonthlyUsd": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,6}(\\.[0-9]{1,6})?$"
        },
        "deploymentMonthlyUsd": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,6}(\\.[0-9]{1,6})?$"
        },
        "registry": {
          "type": "string",
          "pattern": "^$|^\\{"
        }
      }
    },
    "dispatcher": {
      "description": "The notification dispatcher's configuration file (DEC-2500 item 7, DEC-2516 item 2), rendered into the ConfigMap `dispatcher-config` once images.dispatcher is named: the one recipient its email channel mails, in DEC-710 item 4's form, the build digest of its binary, and the subject streams beside those the control stream names (a floor). No member is a secret or an address; the workspace, the environment and the app origin come from `api.workspace`, `environment` and `api.appOrigin`",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "build",
        "subjects"
      ],
      "properties": {
        "recipient": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9_]{0,63}$"
        },
        "build": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data": {
      "description": "The data process (mandate-datad): where its bars come from, `recorded` or `alpaca-iex` (DEC-2082), and the recorded series' instruments, each with its asset id, which the closes object names, and its series' anchor, `<YYYY-MM-DD>=<close>`; a recording, so only the local cell's values list any",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruments",
        "source"
      ],
      "properties": {
        "instruments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "assetId",
              "anchor"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
              },
              "assetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "anchor": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}=[0-9]{1,9}(\\.[0-9]{1,9})?$"
              }
            }
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "recorded",
            "alpaca-iex"
          ]
        }
      }
    },
    "news": {
      "description": "The news reader's followed agents, each an agent and the broker account its executor trades (DEC-2281), and the user agent the vendor sees (DEC-2084); ids and a contact only, never a secret",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "follows",
        "userAgent"
      ],
      "properties": {
        "follows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "account"
            ],
            "properties": {
              "agent": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "account": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              }
            }
          }
        },
        "userAgent": {
          "type": "string",
          "pattern": "^[ -~]*@[ -~]*$",
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "executor": {
      "description": "The broker every executor runs over (DEC-2306 item 1); a vault address, never a secret",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "vaultAddress"
      ],
      "properties": {
        "broker": {
          "enum": [
            "fixture",
            "alpaca-paper"
          ]
        },
        "vaultAddress": {
          "type": "string",
          "pattern": "^$|^https://[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?(:[0-9]{1,5})?$"
        }
      },
      "if": {
        "properties": {
          "broker": {
            "const": "alpaca-paper"
          }
        }
      },
      "then": {
        "properties": {
          "vaultAddress": {
            "minLength": 1
          }
        }
      }
    },
    "localImages": {
      "type": "boolean",
      "description": "true only in the local cell's values: allows mandate.local/ images"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloudflared"
      ],
      "properties": {
        "cloudflared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "tokenFrom",
            "edge"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"
            },
            "tokenFrom": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "edge": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(2[4-9]|3[0-2])$"
              }
            }
          }
        }
      }
    },
    "api": {
      "description": "The workspace API server's settings (workspace API spec §3.11 item 2), each required once images.api is named. None is a secret: the session signing key is made in the pod's memory at each start, and the subject links are a ConfigMap the operator makes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org",
        "workspace",
        "issuer",
        "audience",
        "jwksUrl",
        "appOrigin",
        "subjectLinks",
        "ingressPeers",
        "vaultBinding",
        "connectFinish",
        "stepUpCoolOffWaiver"
      ],
      "properties": {
        "org": {
          "type": "string",
          "pattern": "^$|^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "MANDATE_API_ORG: the hosted workspace's organization, a ULID"
        },
        "workspace": {
          "type": "string",
          "pattern": "^$|^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "MANDATE_API_WORKSPACE: the one workspace this deployment hosts, a ULID"
        },
        "issuer": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "MANDATE_API_ISSUER"
        },
        "audience": {
          "type": "string",
          "pattern": "^[^\\s]*$",
          "description": "MANDATE_API_AUDIENCE"
        },
        "jwksUrl": {
          "type": "string",
          "pattern": "^$|^https://[^\\s]+$|^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?/[^\\s]*$",
          "description": "MANDATE_API_JWKS_URL: https, or loopback http only (a dev or ci cell's stub issuer, DEC-2100)"
        },
        "appOrigin": {
          "type": "string",
          "pattern": "^$|^https://[a-z0-9.-]+(:[0-9]+)?$",
          "description": "MANDATE_API_APP_ORIGIN"
        },
        "subjectLinks": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "The ConfigMap whose `subject-links` key is mounted at /etc/mandate/subject-links (DEC-1023); empty mounts none, and every sign-in is refused"
        },
        "ingressPeers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$|^[0-9a-f:]*:[0-9a-f:]*$|^[0-9a-f:]*:((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
          },
          "description": "MANDATE_API_INGRESS_PEERS: the ingress's own exact addresses, IPv4 (each octet 0 to 255), IPv6, or IPv4-mapped IPv6, from which alone route 2's limits read X-Forwarded-For (workspace API spec §4.10, DEC-2117 item 4); empty reads none"
        },
        "vaultBinding": {
          "type": "boolean",
          "description": "The API's vault binding (DEC-2338): its AppRole and the vault's CA as owner-only files, and egress to the vault on 8200."
        },
        "connectFinish": {
          "type": "boolean",
          "description": "The connect finish's Deployment, from the API's image, holding the connection manager's AppRole alone as owner-only files, with egress to the journal and the vault on 8200 (DEC-2348 item 3)."
        },
        "stepUpCoolOffWaiver": {
          "type": "boolean",
          "description": "MANDATE_API_STEP_UP_COOL_OFF_WAIVER=true: a dev or ci cell's waiver of a first passkey's 24-hour enrolment cool-off at step-up, each waiver journaled as StepUpCoolOffWaived (DEC-2146), and a staging cell's until stepUpCoolOffWaiverUntil (DEC-2150); production refuses it"
        },
        "stepUpCoolOffWaiverUntil": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "MANDATE_API_STEP_UP_COOL_OFF_WAIVER_UNTIL: the waiver's expiry, YYYY-MM-DDTHH:MM:SSZ in UTC, required with the waiver in staging and only with the waiver. The API refuses at start a staging expiry later than the ceiling it is built with, 2026-11-05T00:00:00Z, and counts no waiver at or after it (DEC-2150)"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "storageClass",
        "accessMode"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      }
    },
    "researchArtifacts": {
      "description": "The research store (DEC-2279 item 5), which only the model gateway writes. Its size is whole gibibytes or tebibytes, at least 1Gi, so it is always at least twice the gateway's fixed 512 MiB cap (item 4)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "storageClass",
        "accessMode"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Ti)$"
        },
        "storageClass": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      }
    },
    "founding": {
      "description": "The workspace's founding grant (DEC-2114, DEC-2860): with enabled, the chart renders the Job that runs `workspace found --open` for member on api.workspace into the ConfigMap founding-job, and the infra apply makes it. Ids only: the founder's identity-provider subject is never a value",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "member"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "member": {
          "description": "The founder's principal, an opaque ULID (identity spec §3.1), or empty when founding is off",
          "type": "string",
          "pattern": "^([0-7][0-9A-HJKMNP-TV-Z]{25})?$"
        }
      }
    },
    "alpacaOAuth": {
      "description": "The paper Alpaca OAuth app's public settings (DEC-2636), rendered into the API and the token exchange only. No secret: the client secret is the vault's.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "redirectUri"
      ],
      "properties": {
        "clientId": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,128}$",
          "description": "MANDATE_ALPACA_CLIENT_ID"
        },
        "redirectUri": {
          "type": "string",
          "pattern": "^$|^https://[a-z0-9.-]+(:[0-9]+)?/v1/oauth/alpaca/callback$|^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?/v1/oauth/alpaca/callback$",
          "description": "MANDATE_ALPACA_REDIRECT_URI: the callback on this deployment's API host (DEC-2623 item 2)"
        }
      }
    },
    "oauthFixture": {
      "description": "The fixture OAuth provider's own pod (DEC-1176): dev and ci cells only, and the token exchange's token URL pointed at it. Any other tier refuses it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
