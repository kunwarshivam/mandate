# The workspace API (DEC-822). This unit is also the template the runtime and executor units copy:
# change Description, User and Group, ExecStart (with its --bind), EnvironmentFile, LoadCredential, and keep every
# hardening line below unless a service shows it needs one relaxed (and says why in a comment).
#
# It does not start until /usr/local/bin/mandate-api-server exists. It reads its settings from
# /etc/owlhead/api.env, which holds no secret, and its two secrets as systemd credentials
# (DEC-822 item 4): root:root 0600 files systemd hands it in $CREDENTIALS_DIRECTORY, readable by
# this service alone and never in its environment.
[Unit]
Description=Owlhead workspace API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
ConditionPathExists=/usr/local/bin/mandate-api-server

[Service]
Type=simple
User=owlhead_api
Group=owlhead_api
EnvironmentFile=/etc/owlhead/api.env
LoadCredential=vault-pending-key:/etc/owlhead/credentials/vault-pending-key
LoadCredential=session-signing-key:/etc/owlhead/credentials/session-signing-key
# Loopback only: Cloudflare's tunnel is the only way in (DEC-822 item 2). The bind is an argument,
# not an Environment= line, which EnvironmentFile= would override.
ExecStart=/usr/local/bin/mandate-api-server --bind 127.0.0.1:8080
Restart=on-failure
RestartSec=2s

# Writable: the artifact store and the vault's two directories; bootstrap.sh owns their layout
# (DEC-692). No StateDirectory=, which would chown /var/lib/owlhead to this user.
ReadWritePaths=/var/lib/owlhead/artifacts /var/lib/owlhead/vault/pending /var/lib/owlhead/vault/tokens
UMask=0027

# Default-deny egress (DEC-822 item 5): only loopback (Postgres's socket needs no IP at all). The
# Supabase host the API needs for OIDC and JWKS (DEC-820) is added per host by
# deploy/allow-egress.sh as a drop-in, never in this file.
IPAddressDeny=any
IPAddressAllow=localhost

# Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SocketBindAllow=tcp:8080
SocketBindDeny=any

[Install]
WantedBy=multi-user.target
