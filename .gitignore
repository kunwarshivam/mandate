agent-tools/
__pycache__/
/target/
/fuzz/target/
.venv/
*.pyc

# Paper-trading keys never live in the repository (ADR-0001 ES-19).
.env
.env.*
/mutants.out*/

# Downloaded market data is research data, never committed (E2-1, DEC-89).
/data/

# Claude Code local state (subagent worktrees); never part of the repository
.claude/

# proptest writes failure seeds next to the test that produced them; never committed
*.proptest-regressions
proptest-regressions/

# The CI runners' root is applied from the founder's machine (DEC-2065): its working directory and
# its encrypted local state never enter the repository.
/deploy/tofu/environments/ci-runners/.terraform/
/deploy/tofu/environments/ci-runners/ci-runners.tfstate*
